# API / Supabase (copy to `.env` in repo root or `apps/api`)

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# T-05: Storage signed URLs + `files` rows (server only; never ship to web)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TTL for signed *download* URLs (seconds). Upload sign TTL is fixed by Supabase (~2h).
SIGNED_URL_TTL_SECONDS=3600

API_PORT=3001
CORS_ORIGIN=http://localhost:5173
