# API / Supabase (copy to `.env` in repo root or `apps/api`)

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# T-05: Storage signed URLs + `files` rows (server only; never ship to web)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bootstrap del primer administrador (server only; no commitear valores reales)
BOOTSTRAP_ADMIN_EMAIL=

# TTL for signed *download* URLs (seconds). Upload sign TTL is fixed by Supabase (~2h).
SIGNED_URL_TTL_SECONDS=3600

API_PORT=3001
# Orígenes del front en dev (Vite usa 5173; si está ocupado, 5174)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
PUBLIC_WEB_URL=http://localhost:5174

# T-10 — Cuota tamaño DWG (bytes). Vacío o 0 = sin límite en API (ver apps/api/.env.example)
QUOTA_DWG_MAX_BYTES=

# Web (Vite) — usadas por scripts/sync-dev-env.sh → apps/web/.env
VITE_API_URL=http://localhost:3001
