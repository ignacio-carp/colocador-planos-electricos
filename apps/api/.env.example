SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
API_PORT=3001
# Origen del front en dev (coma para varios; Vite puede usar 5174 si 5173 está ocupado)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Bootstrap del primer administrador (server only; no commitear valores reales)
BOOTSTRAP_ADMIN_EMAIL=

# T-06 / US-001 — Resend (ver docs/adr/ADR-002-transactional-email-provider.md)
RESEND_API_KEY=
# En pruebas sin dominio propio: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev
# URL pública del front (enlace en el correo)
PUBLIC_WEB_URL=http://localhost:5174

# Invitaciones: TTL del token (ms); rate limit por admin
INVITE_TOKEN_TTL_MS=604800000
INVITE_RATE_LIMIT_WINDOW_MS=3600000
INVITE_RATE_LIMIT_MAX=30

# T-10 — Cuotas extensibles (MVP: límite tamaño DWG opcional)
# Vacío o 0 = desactivado. Para activar, p. ej. 50 MiB: 52428800
# Valor documentado recomendado al habilitar: 104857600 (100 MiB)
QUOTA_DWG_MAX_BYTES=

# S-01 — Cola async del pipeline (habilitado por defecto salvo NODE_ENV=test)
# PIPELINE_WORKER_ENABLED=true
# PIPELINE_WORKER_POLL_MS=500
# PIPELINE_SYNC_PROCESS=true

# N1–N3 — Pipeline IA/CAD: stub (default) | live (OpenAI + cad_worker apply-electrical-layer)
# CAD_PIPELINE_MODE=stub
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o
# VISION_API_TIMEOUT_MS=60000
# NORMATIVE_API_TIMEOUT_MS=45000
# CAD_IA_SIMULATE_FAILURE=true
# cad-worker: local spawn (default) o servicio HTTP en Railway
# CAD_WORKER_URL=https://<cad-worker-service>.up.railway.app
# CAD_WORKER_TIMEOUT_MS=60000
# CAD_WORKER_PYTHON=/path/to/python3
# CAD_WORKER_DISABLED=true
# CAD_WORKER_FIXTURE_DXF=
