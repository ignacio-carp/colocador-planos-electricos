{
  "name": "cambre-planos-electricos-mvp",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace web run dev",
    "dev:api": "npm --workspace api run dev",
    "dev": "bash scripts/dev.sh",
    "dev:setup": "bash scripts/dev.sh --setup-only",
    "supabase:login": "bash scripts/supabase-login.sh",
    "env:sync": "bash scripts/sync-dev-env.sh",
    "lint": "npm -ws run lint",
    "format": "npm -ws run format",
    "typecheck": "npm -ws run typecheck",
    "build": "npm -ws run build",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}

