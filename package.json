{
  "name": "cambre-planos-electricos-mvp",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace web run dev",
    "dev:api": "npm --workspace api run dev",
    "dev": "npm run dev:web & npm run dev:api",
    "lint": "npm -ws run lint",
    "format": "npm -ws run format",
    "typecheck": "npm -ws run typecheck",
    "build": "npm -ws run build",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}

